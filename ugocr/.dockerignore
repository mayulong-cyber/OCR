# Python bytecode and caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Git
.git/
.gitattributes

# Environment files (keep examples)
.env
.env.local
.env.prod

# Logs
*.log
logs/

