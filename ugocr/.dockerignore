.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code
.claude/

# OS files
.DS_Store
Thumbs.db

# Project data (runtime generated)
data/uploads/*
data/outputs/*

# Training assets (not needed at runtime)
training/

# Tests (not needed at runtime)
tests/

# Scripts (not needed at runtime)
scripts/

